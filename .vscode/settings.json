{
  "editor.formatOnSave": true,

  // JS/JSON/Markdown -> Prettier (resolved from the project's node_modules)
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // .cds files -> CAP's own cds-prettier, shipped in the SAP CDS extension.
  // Prettier does not understand CDL/CQL, so it must never touch these.
  "[cds]": {
    "editor.defaultFormatter": "SAPSE.vscode-cds"
  },

  // Overrides the user's global "[javascript]" default formatter (set to
  // ESLint), which otherwise wins over the setting above for JS files.
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true
}
